includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes
        - tests

    # Nivel 6 e o ponto onde a analise passa a exigir tipagem de verdade sem
    # brigar com o Eloquent. Subir para 8 quando o dominio estiver estavel.
    level: 6

    # Faz o Larastan LER o corpo do metodo casts() dos models, em vez de olhar
    # so a assinatura `: array`. Sem isto, ele nao sabe que data_nascimento e
    # CarbonImmutable nem que situacao e um enum — e passa a acusar erro em
    # codigo correto, do tipo "Cannot call diffInYears() on string".
    parseModelCastsMethod: true

    # Confere se a propriedade existe de fato na tabela. Depende do
    # databaseMigrationsPath abaixo para descobrir o schema.
    checkModelProperties: true

    databaseMigrationsPath:
        - database/migrations

    ignoreErrors:
        # LIMITACAO DE DEPENDENCIA, NAO ERRO NOSSO.
        #
        # Livewire\LivewireManager::test() declara
        #     @param class-string<TComponent>|TComponent|string|array $name
        # e a uniao com `string` puro impede o PHPStan de resolver TComponent:
        # `Lista::class` satisfaz os dois primeiros ramos ao mesmo tempo.
        #
        # Nao ha como corrigir do nosso lado sem passar uma instancia ja
        # construida para o helper de teste, o que mudaria o comportamento em
        # tempo de execucao para agradar o analisador — troca ruim.
        #
        # Escopo minimo de proposito: so este identificador, so nos testes.
        # Se a assinatura for corrigida upstream, esta entrada passa a acusar
        # "padrao nao utilizado" e sai daqui.
        -
            identifier: argument.templateType
            path: tests/*
            reportUnmatched: false
